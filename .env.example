# Copy this file to .env.local and fill in the values. .env.local is gitignored — never commit it.
# Find these on your Supabase project dashboard: the "Connect" button, or Project Settings → API Keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser; read-only via RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY — bypasses row level security. Used by the data sync.
SUPABASE_SECRET_KEY=

# Passphrase for the in-app "Update data" button (/data) and the post-sync revalidation call. Use a long random string.
SYNC_SECRET=

# Deployed only: fine-grained GitHub token with "Actions: read and write" on this repo, so the Update button can
# start the "Data sync" workflow. Locally (npm run dev) the button runs the sync on your machine instead.
GITHUB_DISPATCH_TOKEN=

# Deployed only (set as a GitHub Actions variable, not here): the app's public URL, so the sync can refresh cached pages.
# APP_URL=https://your-app.vercel.app
