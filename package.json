    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
